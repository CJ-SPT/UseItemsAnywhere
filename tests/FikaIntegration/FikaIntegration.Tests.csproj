<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <TarkovDir Condition="'$(TarkovDir)' == ''">$(MSBuildThisFileDirectory)..\..\..\..\</TarkovDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../UseItemsAnywhere/Integration/*.cs" Link="%(Filename)%(Extension)" />
    <Compile Include="../../UseItemsAnywhere/Patches/ItemAccessDelayPatch.cs" Link="ItemAccessDelayPatch.cs" />
    <Compile Include="../../UseItemsAnywhereFika/RulesCodec.cs" Link="RulesCodec.cs" />
    <Compile Include="../../UseItemsAnywhereFika/RulesPackets.cs" Link="RulesPackets.cs" />
    <Reference Include="Newtonsoft.Json" HintPath="$(TarkovDir)EscapeFromTarkov_Data/Managed/Newtonsoft.Json.dll" />
    <Reference Include="Fika.Core" HintPath="$(TarkovDir)BepInEx/plugins/Fika/Fika.Core.dll" />
    <Reference Include="Mono.Cecil" HintPath="$(TarkovDir)BepInEx/core/Mono.Cecil.dll" />
  </ItemGroup>
</Project>
